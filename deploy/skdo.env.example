# Copy to deploy/skdo.env (docker) or /etc/skdo/skdo.env (systemd). Everything is optional:
# unset values are detected from the host or default to the shipped contract.

# --- Which press this is (applied on first start if site/site.yaml does not exist yet) ---
SKDO_PRESS_ID=Press01
SKDO_OPCUA_NAMESPACE=2
SKDO_OPCUA_ENDPOINT=opc.tcp://press-plc.local:4840

# --- Overrides for the auto-detected host profile ---
# SKDO_TIER=full                 # edge | standard | full   (default: chosen from cores and RAM)
# SKDO_WORKERS=4
# SKDO_DEVICE=cpu                # cpu | cuda
# SKDO_LATENCY_BUDGET_MS=200
